# Smart Room Scheduler Environment Configuration

# Server Port (default: 3000)
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV=production

# Google Gemini API Key & Model Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Workspace / OAuth 2.0 Client ID (Client-side Calendar & Drive sync)
VITE_GOOGLE_CLIENT_ID=

# Optional: Custom Firebase Credentials (falls back to internal config if omitted)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Email / SMTP Configuration (Optional: for booking confirmations & notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IIT BHU Room Booking <noreply@iitbhu.ac.in>"
