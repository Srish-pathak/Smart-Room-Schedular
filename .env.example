# Smart Room Scheduler Environment Configuration

# Server Port (default: 3000)
PORT=3000

# Google Gemini API Key (Server-side AI Room Allocation Assistant)
GEMINI_API_KEY=

# Google Workspace / OAuth 2.0 Client ID (Client-side Calendar & Drive sync)
VITE_GOOGLE_CLIENT_ID=

# Email / SMTP Configuration (Optional: for booking confirmations & notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IIT BHU Room Booking <noreply@iitbhu.ac.in>"
